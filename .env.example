# Google Maps API key with Places API enabled.
# Provision at https://console.cloud.google.com/apis/credentials
# Free tier covers ~50 lookups per trip; no billing setup needed for our usage.
GOOGLE_MAPS_API_KEY=

# Rakuten Web Service — Travel APIs.
# Register a free app at https://webservice.rakuten.co.jp/app/list
# BOTH values are issued on that same page and BOTH are required: applicationId
# alone returns a bare `400 wrong_parameter` with no useful message.
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Optional. Rakuten affiliate ID; appended to reserve URLs when set. Leave blank.
RAKUTEN_AFFILIATE_ID=

# Display-only yen→kroner rate, e.g. 22.5 means ¥22.5 = 1 kr. Hand-maintained;
# there is deliberately no currency API in this project (see CLAUDE.md).
JPY_PER_DKK=
